# macOS 系统文件
.DS_Store
.AppleDouble
LSOverride

# Gradle 缓存与构建产物（wrapper jar 需要提交，单独放行）
.gradle/
**/build/
!gradle/wrapper/gradle-wrapper.jar

# IntelliJ IDEA / Android Studio：整个目录由本机 IDE 生成，不纳入版本控制
.idea/

# 各平台原生二进制：由 scripts/fetch-ffmpeg* 下载/构建到 resources/<平台>/，
# 不入仓库（体积超过 GitHub 单文件 100MB 限制）。压缩包缓存在
# %GRADLE_USER_HOME%/vlcSetup/，或用 KTDOWNLOAD_FFMPEG_ZIP 预置；
# 详见 README「Windows 打包与 FFmpeg」。
# 例外：third-party/binaries/ 里的预置归档是打包输入，必须提交（离线打包用）。
resources/macos/
resources/windows/
resources/linux/
!third-party/binaries/
*.dylib
*.dll
*.so

# 日志与本地属性
*.log
local.properties

# 工作记录（非项目源码）
.workbuddy/
.kotlin/

# 代码走查 / 评审文档：仅本地留存，不入仓库
docs/
