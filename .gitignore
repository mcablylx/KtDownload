# macOS 系统文件
.DS_Store
.AppleDouble
LSOverride

# Gradle 缓存与构建产物（wrapper jar 需要提交，单独放行）
.gradle/
**/build/
!gradle/wrapper/gradle-wrapper.jar

# IntelliJ IDEA / Android Studio 的本机状态（项目级配置仍提交）
.idea/workspace.xml
.idea/shelf/
.idea/httpRequests/
.idea/artifacts/
.idea/AndroidProjectSystem.xml
.idea/MarsCodeWorkspaceAppSettings.xml
.idea/dataSources/
.idea/dataSources.local.xml

# 各平台原生二进制：由 scripts/fetch-ffmpeg* 下载/构建，不入仓库
resources/macos/
resources/windows/
resources/linux/
*.dylib
*.dll
*.so

# 日志与本地属性
*.log
local.properties

# 工作记录（非项目源码）
.workbuddy/
